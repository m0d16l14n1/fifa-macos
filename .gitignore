# FIFA 19 (Xbox 360) for macOS. Nothing of the game is in git: bring your own copy.

# The extracted game and original executables
/game/
/FIFA-19/
*.iso
*.xex
*.xex.dll
*.big
*.bh

# Code generated from the game by `rexglue codegen`
/generated/

# The SDK checkout (built from patches/ by scripts/sdk.sh) and build outputs
/third_party/
/out/
build/

# Local agent tooling
/agents/
/skills/
/.claude/

# Per-user and OS files
.DS_Store
*.log
*.orig
*.rej
__pycache__/
*.pyc

# Captures from test runs (dev pad shots, metal_present_capture) anywhere in the tree
*.ppm

# Mods and their data: built mods, fetched squads and logos, unpacked game files (scripts and configs are in
# tools/modding; what they make stays local)
/mods/
/downloaded_files/
*.rx3
*.dds
*.db
*-meta.xml
# The PC game's squads saves (an update's file: Squads<date>), wherever one is put
Squads[0-9]*
/tools/modding/sources/stats-dump
/tools/modding/sources/RPL-kit-stuff
/tools/modding/sources/kits-season-25-26
/tools/modding/sources/minifaces
/tools/modding/sources/adboards
/tools/modding/sources/crests
/tools/modding/sources/fc-26-banners-flags
