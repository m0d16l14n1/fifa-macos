 src/codegen/codegen_writer.cpp                |  4 ++
 src/codegen/config.cpp                        |  4 ++
 src/system/function_dispatcher.cpp            | 52 ++++++++++++++-----
 src/system/runtime.cpp                        |  2 +-
 src/system/xmemory.cpp                        |  4 +-
 13 files changed, 69 insertions(+), 24 deletions(-)

diff --git a/include/rex/codegen/config.h b/include/rex/codegen/config.h
index 5b92270..0d40079 100644
--- a/include/rex/codegen/config.h
+++ b/include/rex/codegen/config.h
