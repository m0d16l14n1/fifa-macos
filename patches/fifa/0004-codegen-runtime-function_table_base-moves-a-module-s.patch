 include/rex/image_info.h                      |  1 +
 include/rex/system/function_dispatcher.h      |  8 ++-
 include/rex/system/xmemory.h                  |  7 ++-
 .../templates/codegen/_indirect_call.inja     |  5 +-
 resources/templates/codegen/init_cpp.inja     |  1 +
 resources/templates/codegen/pch_h.inja        |  1 +
