+  /// Guest address of this module's indirect-call table (twice the code size, plus the thunk
+  /// reserve). 0 puts it right after the image; set it when that would run into another module.
+  uint32_t functionTableBase = 0;
   uint32_t longJmpAddress = 0;
   uint32_t setJmpAddress = 0;
 
