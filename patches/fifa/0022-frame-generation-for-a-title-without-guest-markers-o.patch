+uint32_t CommandProcessor::MarkerRuleForDraw() {
+  if (!marker_rules_parsed_) {
+    marker_rules_parsed_ = true;
+    const std::string rules = REXCVAR_GET(guest_marker_rules);
+    size_t start = 0;
+    while (start < rules.size()) {
+      const size_t comma = rules.find(',', start);
+      const std::string entry =
+          rules.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+      start = comma == std::string::npos ? rules.size() : comma + 1;
+      const size_t colon = entry.find(':');
+      if (colon == std::string::npos) {
+        continue;
+      }
+      const uint64_t hash = std::strtoull(entry.substr(0, colon).c_str(), nullptr, 16);
+      const std::string kind = entry.substr(colon + 1);
+      GuestMarkerKind marker = GuestMarkerKind(0);
+      if (kind == "tonemap") marker = GuestMarkerKind::kTonemapBegin;
+      else if (kind == "ui") marker = GuestMarkerKind::kUIBegin;
+      else if (kind == "scene_end") marker = GuestMarkerKind::kSceneEnd;
+      else if (kind == "render_end") marker = GuestMarkerKind::kRenderEnd;
+      if (hash && uint32_t(marker)) {
+        marker_rules_.emplace_back(hash, uint32_t(marker));
+      } else {
+        REXGPU_WARN("guest_marker_rules: '{}' is not <pixel shader hash>:<marker>", entry);
+      }
+    }
+    if (!marker_rules_.empty()) {
+      REXGPU_INFO("Guest markers: {} rules (guest_marker_rules)", marker_rules_.size());
+    }
+  }
+  if (marker_rules_.empty()) {
+    return 0;
+  }
+  Shader* pixel_shader = active_pixel_shader();
+  if (!pixel_shader) {
+    return 0;
+  }
+  const uint64_t hash = pixel_shader->ucode_data_hash();
+  for (const auto& [rule_hash, kind] : marker_rules_) {
+    if (rule_hash == hash) {
+      return kind;
+    }
+  }
+  return 0;
+}
