+    } else {
+      // NDC (0, 0, z) to world, for a view-projection's inverse (row vectors).
+      auto unproject = [](const Mat4 inv, double z, double out[3]) {
+        double v[4] = {};
+        const double ndc[4] = {0.0, 0.0, z, 1.0};
+        for (uint32_t j = 0; j < 4; ++j) {
+          for (uint32_t i = 0; i < 4; ++i) {
+            v[j] += ndc[i] * inv[i][j];
+          }
+        }
+        const double w = std::abs(v[3]) > 1e-12 ? v[3] : 1e-12;
