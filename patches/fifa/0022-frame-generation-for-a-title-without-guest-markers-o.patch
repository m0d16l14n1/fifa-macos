+      if (marker && marker != uint32_t(GuestMarkerKind::kTonemapBegin)) {
+        OnGuestMarker(marker, 0);
+      }
       // HDR output: the UI layer (may change the alpha blend for this draw).
       bool hdr_blend_overridden = HdrBeforeDraw();
       // Temporal AA: a title profile's scene and camera, then the anti-aliasing pass before this draw.
       TaaProfileBeforeDraw();
       taa_pending_ = TaaCheckDraw();
+      if (marker == uint32_t(GuestMarkerKind::kTonemapBegin)) {
+        OnGuestMarker(marker, 0);
+      }
       const bool occlusion_draw = occlusion_guest_open_ && occlusion_host_began_;
       const uint64_t host_draws_recorded_before = host_draws_recorded_;
       draw_succeeded = IssueDraw(vgt_draw_initiator.prim_type, vgt_draw_initiator.num_indices,
