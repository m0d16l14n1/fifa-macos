+        ray_then[i] = mid_then[i] - near_then[i];
+        moved_near[i] = near_now[i] - near_then[i];
+      }
+      auto length = [](const double v[3]) { return std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); };
+      const double now_length = length(ray_now), then_length = length(ray_then);
+      if (now_length > 1e-9 && then_length > 1e-9) {
