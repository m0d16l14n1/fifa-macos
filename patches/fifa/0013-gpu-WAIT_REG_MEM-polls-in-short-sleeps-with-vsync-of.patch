From 5ddfb564d8aa45de865022c410aeb20649cb0dda Mon Sep 17 00:00:00 2001
From: Nick <nekreshen@yandex.ru>
Date: Sat, 7 Nov 2026 17:00:55 +0700
Subject: [PATCH 13/13] gpu: WAIT_REG_MEM polls in short sleeps with vsync off
 too

With vsync off the command processor still spun (yield) on every unmatched
value, taking a core from the guest threads it was waiting for; uncapped
frames came at uneven times. The 50 us yield then gpu_wait_poll_us sleeps
apply in both modes.
---
 src/graphics/command_processor.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 254687e..fae2efe 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -2325,9 +2325,10 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         // What is polled is mostly a value the guest's CPU writes for the GPU to go on (or a fence the guest
         // itself waits for): the wait ends as soon as it changes. The guest's interval (wait / 0x100 ms) as a
         // sleep added a millisecond or more to every such handoff, several a frame. Yield first, then poll in
-        // short sleeps.
+        // short sleeps. (Also uncapped, vsync off: spinning here only took a core from the guest threads it waits
+        // for, and made uncapped frames uneven.)
         const int32_t poll_us = REXCVAR_GET(gpu_wait_poll_us);
-        if (!REXCVAR_GET(vsync) || poll_us <= 0 ||
+        if (poll_us <= 0 ||
             std::chrono::steady_clock::now() - wait_start < std::chrono::microseconds(50)) {
           rex::thread::MaybeYield();
         } else {
