From 5ca0dcf053ec87b82ac7b41fb177a6bf91d71361 Mon Sep 17 00:00:00 2001
From: Nick <nekreshen@yandex.ru>
Date: Sat, 7 Nov 2026 15:55:05 +0700
Subject: [PATCH 09/13] gpu: WAIT_REG_MEM polls in short sleeps instead of
 whole milliseconds

The command processor slept wait/0x100 ms (1 ms or more) whenever a polled
value did not match yet. FIFA 19's render thread hands the GPU a value and
spins on the D3D fence meanwhile, several times a frame, so every handoff
cost at least a millisecond on both sides: 26-39 ms frames in a match. It now
yields for 50 us, then sleeps gpu_wait_poll_us (100 us by default, never more
than the guest's own interval). A match runs at the 60 Hz cap (17.1 ms).
gpu_wait_stats logs where the waits go.
---
 src/graphics/command_processor.cpp | 67 ++++++++++++++++++++++++++++--
 1 file changed, 64 insertions(+), 3 deletions(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 93da627..254687e 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -41,6 +41,15 @@
 #include <rex/system/kernel_state.h>
 #include <rex/system/user_module.h>
 #include <rex/ui/low_latency.h>
+
+#include <unordered_map>
+
+REXCVAR_DEFINE_INT32(gpu_wait_poll_us, 100, "GPU",
+                     "WAIT_REG_MEM: after 50 us of yielding, poll the value in sleeps of this many microseconds "
+                     "(at most the guest's own interval). 0: yield only (busy)")
+    .range(0, 100000);
+REXCVAR_DEFINE_BOOL(gpu_wait_stats, false, "GPU",
+                    "Diagnostic: every 10 s, log where the command processor waited in WAIT_REG_MEM and for how long");
 #include <rex/ui/presenter.h>
 
 REXCVAR_DEFINE_BOOL(vsync, true, "GPU", "Enable vertical sync");
@@ -2215,6 +2224,43 @@ bool CommandProcessor::ExecutePacketType3_INDIRECT_BUFFER(memory::RingBuffer* re
   return true;
 }
 
+namespace {
+
+// Time the command processor spent in WAIT_REG_MEM, by what it polled (gpu_wait_stats).
+struct WaitRegMemStats {
+  struct Entry {
+    uint64_t waits = 0, us = 0;
+    uint32_t ref = 0, mask = 0, wait_info = 0;
+  };
+  std::unordered_map<uint64_t, Entry> by_target;  // (is_memory << 32) | address
+  std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+
+  void Add(bool is_memory, uint32_t address, uint32_t wait_info, uint32_t ref, uint32_t mask, uint64_t us) {
+    Entry& e = by_target[(uint64_t(is_memory) << 32) | address];
+    ++e.waits;
+    e.us += us;
+    e.ref = ref;
+    e.mask = mask;
+    e.wait_info = wait_info;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - since < std::chrono::seconds(10)) return;
+    const double seconds = std::chrono::duration<double>(now - since).count();
+    std::vector<std::pair<uint64_t, Entry>> sorted(by_target.begin(), by_target.end());
+    std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) { return a.second.us > b.second.us; });
+    std::string text;
+    for (size_t i = 0; i < sorted.size() && i < 4; ++i) {
+      const auto& [key, v] = sorted[i];
+      text += fmt::format(" | {} {:08X} (op {} ref {:X} mask {:X}): {} waits, {:.1f} ms/s", (key >> 32) ? "mem" : "reg",
+                          uint32_t(key), v.wait_info & 7, v.ref, v.mask, v.waits, v.us / 1000.0 / seconds);
+    }
+    REXGPU_INFO("WAIT_REG_MEM over {:.0f} s:{}", seconds, text);
+    by_target.clear();
+    since = now;
+  }
+};
+
+}  // namespace
+
 bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reader, uint32_t packet,
                                                        uint32_t count) {
   SCOPE_profile_cpu_f("gpu");
@@ -2230,6 +2276,8 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
   bool is_memory = (wait_info & 0x10) != 0;
 
   bool matched = false;
+  const auto wait_start = std::chrono::steady_clock::now();
+  bool waited = false;
   do {
     uint32_t value = 0;
     if (is_memory) {
@@ -2270,14 +2318,21 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         break;
     }
     if (!matched) {
+      waited = true;
       // Wait.
       if (wait >= 0x100) {
         PrepareForWait();
-        if (!REXCVAR_GET(vsync)) {
-          // User wants it fast and dangerous.
+        // What is polled is mostly a value the guest's CPU writes for the GPU to go on (or a fence the guest
+        // itself waits for): the wait ends as soon as it changes. The guest's interval (wait / 0x100 ms) as a
+        // sleep added a millisecond or more to every such handoff, several a frame. Yield first, then poll in
+        // short sleeps.
+        const int32_t poll_us = REXCVAR_GET(gpu_wait_poll_us);
+        if (!REXCVAR_GET(vsync) || poll_us <= 0 ||
+            std::chrono::steady_clock::now() - wait_start < std::chrono::microseconds(50)) {
           rex::thread::MaybeYield();
         } else {
-          rex::thread::Sleep(std::chrono::milliseconds(wait / 0x100));
+          rex::thread::Sleep(std::chrono::microseconds(
+              std::min<int64_t>(poll_us, int64_t(wait / 0x100) * 1000)));
         }
         rex::thread::SyncMemory();
         ReturnFromWait();
@@ -2291,6 +2346,12 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
       }
     }
   } while (!matched);
+  if (waited && REXCVAR_GET(gpu_wait_stats)) {
+    static WaitRegMemStats stats;  // the command processor thread only
+    stats.Add(is_memory, poll_reg_addr, wait_info, ref, mask,
+              uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                                             wait_start).count()));
+  }
 
   return true;
 }
