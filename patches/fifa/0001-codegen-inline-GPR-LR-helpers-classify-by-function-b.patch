+      {
+        constexpr std::string_view kSave = "__savegprlr_";
+        constexpr std::string_view kRest = "__restgprlr_";
+        std::string_view view = name;
+        const bool is_save = view.substr(0, kSave.size()) == kSave;
+        const bool is_rest = view.substr(0, kRest.size()) == kRest;
+        if (is_save || is_rest) {
+          const std::string_view digits = view.substr(kSave.size());
+          unsigned n = 0;
+          bool numeric = !digits.empty() && digits.size() <= 2;
+          for (char c : digits) {
+            if (c < '0' || c > '9') {
+              numeric = false;
+              break;
+            }
+            n = n * 10 + unsigned(c - '0');
+          }
+          if (numeric && n >= 14 && n <= 31) {
+            println("\trex_inl_{}gprlr_{}(ctx, base);", is_save ? "save" : "rest", n);
+            return;
+          }
+        }
+      }
