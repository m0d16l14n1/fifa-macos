+  float4 clip = float4(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, d * c.depth_map.x + c.depth_map.y, 1.0f);
   uint row = id * 4u;
   float4 previous = clip.x * c.previous[row] + clip.y * c.previous[row + 1u] + clip.z * c.previous[row + 2u] +
                     clip.w * c.previous[row + 3u];
@@ -509,6 +510,16 @@ kernel void taa_motion_vectors(constant TaaMvConstants& c [[buffer(0)]],
   }
   dest.write(float4(motion, 0.0f, 0.0f), p);
 }
+// temporal AA development (metal_taa_debug_vectors): the motion vectors drawn in place of the anti-aliased
+// scene, hue the direction, brightness the length (full at 8 pixels).
+kernel void taa_debug_vectors(texture2d<float, access::read> motion [[texture(0)]],
+    texture2d<float, access::write> out [[texture(1)]], uint2 p [[thread_position_in_grid]]) {
+  if (p.x >= out.get_width() || p.y >= out.get_height()) return;
+  float2 m = motion.read(min(p, uint2(motion.get_width() - 1u, motion.get_height() - 1u))).xy;
+  float h = (atan2(m.y, m.x) / 6.2831853f + 0.5f) * 6.0f;
+  float3 hue = saturate(float3(abs(h - 3.0f) - 1.0f, 2.0f - abs(h - 2.0f), 2.0f - abs(h - 4.0f)));
+  out.write(float4(hue * saturate(length(m) / 8.0f), 1.0f), p);
+}
