+struct TaaMvConstants { float4 previous[96]; float4 size; float4 jitter; uint4 map; float4 depth_map; };
 uint2 taa_source(uint2 i, uint4 map) { return min((i * map.xy * 2u + map.zw - 1u) / (map.zw * 2u), map.xy - 1u); }
 kernel void taa_motion_vectors(constant TaaMvConstants& c [[buffer(0)]],
     texture2d_array<float, access::read> depth [[texture(0)]], texture2d_array<float, access::read> stencil [[texture(1)]],
@@ -496,7 +497,7 @@ kernel void taa_motion_vectors(constant TaaMvConstants& c [[buffer(0)]],
