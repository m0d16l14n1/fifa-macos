@@ -544,36 +604,62 @@ class PosixCondition<Event> : public PosixConditionBase {
     signal_ = false;
   }
 
+  // PulseEvent: releases the threads waiting at this moment (all of them for a manual-reset event, one for an
+  // auto-reset event) and leaves the event non-signaled, in one step. It was Set, a 10 us sleep and Reset: a
+  // waiter that did not look in those 10 us missed it, and with no waiter a thread arriving then took it.
+  void Pulse() {
+    auto lock = std::unique_lock<std::mutex>(mutex_);
+    if (manual_reset_) {
+      release_boundary_ = next_ticket_;
+    } else if (waiters_ > release_count_) {
+      if (release_count_ == 0) {
+        release_boundary_ = next_ticket_;
+        eligible_waiters_ = waiters_;
+      }
+      ++release_count_;
+    }
+    signal_ = false;
+    NotifyAll();
+  }
+
  private:
-  bool eligible() const {
-    return !manual_reset_ && release_count_ > 0 && tls_wait_object_ == this &&
-           tls_ticket_ < release_boundary_;
+  bool eligible(uint64_t ticket) const {
+    return !manual_reset_ && release_count_ > 0 && ticket < release_boundary_;
   }
-  bool released_by_earlier_set() const {
-    return manual_reset_ && tls_wait_object_ == this && tls_ticket_ < release_boundary_;
+  bool released_by_earlier_set(uint64_t ticket) const {
+    return manual_reset_ && ticket < release_boundary_;
   }
+  bool waiting_here() const { return tls_wait_object_ == this; }
   inline bool signaled() const override {
-    return signal_ || eligible() || released_by_earlier_set();
+    return signal_ || (waiting_here() && (eligible(tls_ticket_) || released_by_earlier_set(tls_ticket_)));
   }
   inline void post_execution() override {
+    if (waiting_here()) {
+      post_execution_for(tls_ticket_);
+    } else if (!manual_reset_) {
+      signal_ = false;
+    }
+  }
+  bool signaled_for(uint64_t ticket) const override {
+    return signal_ || eligible(ticket) || released_by_earlier_set(ticket);
+  }
+  void post_execution_for(uint64_t ticket) override {
     if (manual_reset_) {
       return;
     }
-    if (eligible()) {
+    if (eligible(ticket)) {
       --release_count_;
     } else {
       signal_ = false;
     }
   }
-  void OnWaitEnter() override {
-    tls_wait_object_ = this;
-    tls_ticket_ = next_ticket_++;
+  uint64_t Register() {
     ++waiters_;
+    return next_ticket_++;
   }
-  void OnWaitExit(bool consumed) override {
-    const bool was_eligible = !manual_reset_ && tls_ticket_ < release_boundary_;
+  void Unregister(uint64_t ticket) {
+    const bool was_eligible = !manual_reset_ && ticket < release_boundary_;
     --waiters_;
-    tls_wait_object_ = nullptr;
     if (was_eligible && eligible_waiters_ > 0) {
       --eligible_waiters_;
     }
@@ -582,8 +668,18 @@ class PosixCondition<Event> : public PosixConditionBase {
       signal_ = true;
       release_count_ = eligible_waiters_;
     }
+  }
+  void OnWaitEnter() override {
+    tls_wait_object_ = this;
+    tls_ticket_ = Register();
+  }
+  void OnWaitExit(bool consumed) override {
+    Unregister(tls_ticket_);
+    tls_wait_object_ = nullptr;
     (void)consumed;
   }
+  uint64_t OnMultiWaitEnter() override { return Register(); }
+  void OnMultiWaitExit(uint64_t ticket) override { Unregister(ticket); }
   bool signal_;
   const bool manual_reset_;
   uint32_t waiters_ = 0;
@@ -615,7 +711,7 @@ class PosixCondition<Semaphore> : public PosixConditionBase {
       *out_previous_count = count_;
