+id<MTLTexture> MetalPresenter::SpatialUpscale(id<MTLCommandBuffer> command_buffer, id<MTLTexture> image,
+                                              uint32_t width, uint32_t height, bool hdr) {
+  // Only when enlarging (MetalFX's spatial scaler doesn't shrink) and for SDR (its perceptual mode expects
+  // gamma-encoded colour; PQ would need the HDR mode and a linear input).
+  if (hdr || REXCVAR_GET(metal_present_upscale) != "metalfx" || !image || width <= image.width ||
+      height <= image.height || width > 16384 || height > 16384)
+    return nil;
+  std::lock_guard<std::mutex> lock(spatial_mutex_);
+  if (!spatial_scaler_ || spatial_scaler_.inputWidth != image.width || spatial_scaler_.inputHeight != image.height ||
+      spatial_scaler_.outputWidth != width || spatial_scaler_.outputHeight != height ||
+      spatial_scaler_.colorTextureFormat != image.pixelFormat) {
+    spatial_scaler_ = nil;
+    spatial_output_ = nil;
+    if (![MTLFXSpatialScalerDescriptor supportsDevice:device_]) {
+      if (!spatial_unsupported_logged_) {
+        spatial_unsupported_logged_ = true;
+        REXGPU_WARN("Metal presenter: MetalFX spatial upscaling is not supported on this GPU; bilinear instead");
+      }
+      return nil;
+    }
+    MTLFXSpatialScalerDescriptor* desc = [MTLFXSpatialScalerDescriptor new];
+    desc.inputWidth = image.width;
+    desc.inputHeight = image.height;
+    desc.outputWidth = width;
+    desc.outputHeight = height;
+    desc.colorTextureFormat = image.pixelFormat;
+    desc.outputTextureFormat = image.pixelFormat;
+    desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+    spatial_scaler_ = [desc newSpatialScalerWithDevice:device_];
+    if (!spatial_scaler_) {
+      REXGPU_WARN("Metal presenter: no MetalFX spatial scaler for {}x{} to {}x{}; bilinear instead", image.width,
+                  image.height, width, height);
+      return nil;
+    }
+    MTLTextureDescriptor* out = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:image.pixelFormat
+                                                                                   width:width
+                                                                                  height:height
+                                                                               mipmapped:NO];
+    out.usage = spatial_scaler_.outputTextureUsage | MTLTextureUsageShaderRead;
+    out.storageMode = MTLStorageModePrivate;
+    spatial_output_ = [device_ newTextureWithDescriptor:out];
+    spatial_output_.label = @"rexglue MetalFX spatial output";
+    REXGPU_INFO("Metal presenter: MetalFX spatial upscaling {}x{} to {}x{}", image.width, image.height, width,
+                height);
+  }
+  if (!spatial_output_) return nil;
+  spatial_scaler_.colorTexture = image;
+  spatial_scaler_.outputTexture = spatial_output_;
+  [spatial_scaler_ encodeToCommandBuffer:command_buffer];
+  return spatial_output_;
+}
