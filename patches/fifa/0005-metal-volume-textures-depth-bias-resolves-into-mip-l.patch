+void MetalCommandProcessor::StallWatchdog() {
+  pthread_setname_np("rexglue Metal stall watchdog");
+  const uint64_t limit = uint64_t(REXCVAR_GET(metal_stall_sample_ms));
+  uint64_t reported_for = 0;  // the swap time of the stall already sampled
+  std::unique_lock<std::mutex> lock(stall_mutex_);
+  while (!stall_cv_.wait_for(lock, std::chrono::milliseconds(250), [this] { return stall_quit_; })) {
+    const uint64_t last = last_swap_ms_.load(std::memory_order_relaxed);
+    const uint64_t now = chrono::Clock::QueryHostUptimeMillis();
+    if (now - last < limit || last == reported_for) continue;
+    reported_for = last;
+    const std::time_t wall = std::time(nullptr);
+    char stamp[32];
+    std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", std::localtime(&wall));
+    const std::string file = (std::filesystem::current_path() / fmt::format("stall-{}.txt", stamp)).string();
+    const std::string pid = std::to_string(getpid());
+    REXGPU_WARN("Metal stall: no frame for {} ms; sampling every thread to {}", now - last, file);
+    // /usr/bin/sample <pid> 2 -mayDie -file <path>: two seconds of every thread's stacks.
+    const char* argv[] = {"/usr/bin/sample", pid.c_str(), "2", "-mayDie", "-file", file.c_str(), nullptr};
+    pid_t child = 0;
+    if (posix_spawn(&child, argv[0], nullptr, nullptr, const_cast<char* const*>(argv), nullptr) != 0)
+      REXGPU_WARN("Metal stall: /usr/bin/sample could not be started");
+    // Not waited for here: the sample takes seconds and the thread must still see a quit.
+  }
+}
+
 void MetalCommandProcessor::ShutdownContext() {
+  if (stall_watchdog_.joinable()) {
+    {
+      std::lock_guard<std::mutex> lock(stall_mutex_);
+      stall_quit_ = true;
+    }
+    stall_cv_.notify_all();
+    stall_watchdog_.join();
+  }
   if (command_queue_) {
     @autoreleasepool {
       id<MTLCommandBuffer> drain = [command_queue_ commandBuffer];
@@ -520,7 +569,12 @@ void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
     const double interval = std::chrono::duration<double>(now - last_swap_time_).count();
     if (last_swap_time_ != std::chrono::steady_clock::time_point{} && interval < 0.25)
       frame_interval_ = frame_interval_ > 0.0 ? frame_interval_ * 0.9 + interval * 0.1 : interval;
+    const int32_t hitch_ms = REXCVAR_GET(metal_hitch_log_ms);
+    if (hitch_ms > 0 && last_swap_time_ != std::chrono::steady_clock::time_point{} &&
+        interval * 1000.0 >= double(hitch_ms))
+      REXGPU_WARN("Metal hitch: {:.0f} ms between swaps {} and {}", interval * 1000.0, swaps_ - 1, swaps_);
     last_swap_time_ = now;
+    last_swap_ms_.store(chrono::Clock::QueryHostUptimeMillis(), std::memory_order_relaxed);
   }
   ++stats_swaps_;
   // In free roam on the scripted route (40 s in at 30 swaps a second), when most shaders are loaded.
