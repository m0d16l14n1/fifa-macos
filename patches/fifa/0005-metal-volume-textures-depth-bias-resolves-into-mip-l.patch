@@ -141,10 +153,47 @@ bool MetalCommandProcessor::SetupContext() {
   };
   REXGPU_INFO("Metal backend: native drawing (in development; MSAA is drawn as supersampling)");
   stats_since_ms_ = chrono::Clock::QueryHostUptimeMillis();
+  if (REXCVAR_GET(metal_stall_sample_ms) > 0) {
+    last_swap_ms_.store(chrono::Clock::QueryHostUptimeMillis(), std::memory_order_relaxed);
+    stall_watchdog_ = std::thread([this] { StallWatchdog(); });
+  }
   return true;
