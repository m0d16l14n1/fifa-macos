+          if (fetch.tiled && !cube && !volume_load && layers == 1 && info->block_width == 1 &&
               info->block_height == 1) {
-            AddMipTarget(entry, texture, 0, c.src_base, w, h, layout.base.row_pitch_bytes / bpb, uint32_t(format),
-                         layout.base.level_data_extent_bytes);
