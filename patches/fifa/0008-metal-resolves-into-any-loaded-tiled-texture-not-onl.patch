-}
-bool MetalDraw::ResolveIntoMip(id<MTLTexture> destination, uint32_t address, uint32_t width, uint32_t height,
-                               uint32_t pitch, uint32_t format, uint32_t extent_start, uint32_t extent_length) {
-  if (!REXCVAR_GET(metal_resolve_into_mips)) return false;
-  auto found = mip_targets_.find(address);
-  if (found == mip_targets_.end()) return false;
-  MipTarget& t = found->second;
-  TextureEntry& entry = *t.entry;
-  if (!entry.cached || entry.texture != t.texture) { mip_targets_.erase(found); return false; }
-  // Exactly the level: its size, pitch and format, and no bytes outside it (a larger resolve covers other data).
-  if (t.width != width || t.height != height || t.pitch != pitch || !ResolveFormatMatches(format, t.format) ||
-      t.texture.pixelFormat != destination.pixelFormat || t.level >= t.texture.mipmapLevelCount ||
-      extent_start < address || uint64_t(extent_start) + extent_length > uint64_t(address) + t.length)
+void MetalDraw::AddResolveTarget(TextureEntry& entry, id<MTLTexture> texture, uint32_t level, uint32_t address,
+                                 uint32_t width, uint32_t height, uint32_t pitch, uint32_t format, uint32_t length) {
+  if (!REXCVAR_GET(metal_resolve_into_textures) || !entry.watch) return;  // unwatched: rehashed, reloaded anyway
+  // One target per entry and level: a reload replaces the old texture's.
+  for (auto [i, e] = resolve_targets_.equal_range(address); i != e; ++i) {
+    if (i->second.entry == &entry && i->second.level == level) {
+      i->second = {&entry, texture, level, width, height, pitch, format, length};
+      return;
+    }
+  }
+  resolve_targets_.emplace(address, ResolveTarget{&entry, texture, level, width, height, pitch, format, length});
+}
+bool MetalDraw::ResolveIntoTextures(id<MTLTexture> destination, uint32_t address, uint32_t dx, uint32_t dy,
+                                    uint32_t width, uint32_t height, uint32_t pitch, uint32_t format,
+                                    uint32_t extent_start, uint32_t extent_length) {
+  if (!REXCVAR_GET(metal_resolve_into_textures)) return false;
+  const bool log = REXCVAR_GET(metal_resolve_into_textures_log);
+  const char* why = "no loaded texture at its address";
+  std::vector<ResolveTarget*> takers;
+  for (auto [i, e] = resolve_targets_.equal_range(address); i != e;) {
+    ResolveTarget& t = i->second;
+    if (!t.entry->cached || t.entry->texture != t.texture) {  // stale: the texture was dropped or reloaded
+      i = resolve_targets_.erase(i);
+      continue;
+    }
+    ++i;
+    // The same tiled layout (pitch) and format, the rectangle inside the level, and no bytes outside it.
+    if (t.pitch != pitch) why = "another pitch";
+    else if (!ResolveFormatMatches(format, t.format)) why = "another format";
+    else if (t.texture.pixelFormat != destination.pixelFormat) why = "another pixel format";
+    else if (t.level >= t.texture.mipmapLevelCount) why = "level not loaded";
+    else if (dx >= t.width || dy >= t.height) why = "outside the level";
+    else if (extent_start < address || uint64_t(extent_start) + extent_length > uint64_t(address) + t.length)
+      why = "writes outside the level";
+    else takers.push_back(&t);
+  }
+  if (takers.empty()) {
+    if (log && resolve_misses_logged_.insert(address).second)
+      REXGPU_INFO("Metal resolve into textures: {:08X} at {},{} {}x{} pitch {} format {} (extent {:08X}+{:X}) not "
+                  "copied: {}", address, dx, dy, width, height, pitch, format, extent_start, extent_length, why);
     return false;
-  // The texture stays: out of the range index while the resolve drops what else it overlaps, then back.
-  const uint32_t range_start = entry.range_start, range_length = entry.range_length;
-  const bool had_range = entry.has_range;
-  if (had_range) {
-    for (auto [i, e] = range_index_.equal_range(range_start); i != e; ++i)
+  }
+  // The textures stay: out of the range index while the resolve drops what else it overlaps, then back.
+  struct Kept { TextureEntry* entry; uint32_t start, length; };
+  std::vector<Kept> kept;
+  for (ResolveTarget* t : takers) {
+    TextureEntry& entry = *t->entry;
+    if (!entry.has_range) continue;
+    kept.push_back({&entry, entry.range_start, entry.range_length});
+    for (auto [i, e] = range_index_.equal_range(entry.range_start); i != e; ++i)
       if (i->second.second == &entry) { range_index_.erase(i); break; }
     entry.has_range = false;
   }
   InvalidateRange(extent_start, extent_length);
-  if (had_range) SetTextureRange(entry, range_start, range_length);
+  for (const Kept& k : kept) SetTextureRange(*k.entry, k.start, k.length);
   auto blit = [commands_ blitCommandEncoder];
   if (REXCVAR_GET(metal_debug_labels))
-    blit.label = [NSString stringWithFormat:@"resolve %ux%u into mip %u", width, height, t.level];
-  [blit copyFromTexture:destination sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
-             sourceSize:MTLSizeMake(width, height, 1) toTexture:t.texture destinationSlice:0
-       destinationLevel:t.level destinationOrigin:MTLOriginMake(0, 0, 0)];
+    blit.label = [NSString stringWithFormat:@"resolve %ux%u into %zu texture(s)", width, height, takers.size()];
+  for (ResolveTarget* t : takers) {
+    // A resolve's size is in whole 8x8 blocks: what lies past the level's edge is not copied.
+    const uint32_t w = std::min(width, std::min(uint32_t(destination.width), t->width - dx));
+    const uint32_t h = std::min(height, std::min(uint32_t(destination.height), t->height - dy));
+    [blit copyFromTexture:destination sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+               sourceSize:MTLSizeMake(w, h, 1) toTexture:t->texture destinationSlice:0
+         destinationLevel:t->level destinationOrigin:MTLOriginMake(dx, dy, 0)];
+  }
   [blit endEncoding];
-  ++resolves_into_mips_;
+  ++resolves_into_textures_;
   return true;
 }
 void MetalDraw::InvalidateRange(uint32_t start, uint32_t length) {
@@ -1973,17 +2008,17 @@ id<MTLTexture> MetalDraw::TextureSlow(const MetalTextureBinding& binding) {
           }
