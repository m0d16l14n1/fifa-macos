 }
-void MetalDraw::AddMipTarget(TextureEntry& entry, id<MTLTexture> texture, uint32_t level, uint32_t address,
-                             uint32_t width, uint32_t height, uint32_t pitch, uint32_t format, uint32_t length) {
-  if (!REXCVAR_GET(metal_resolve_into_mips) || !entry.watch) return;  // unwatched: rehashed, would reload anyway
