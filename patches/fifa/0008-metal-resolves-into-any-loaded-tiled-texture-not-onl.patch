 REXCVAR_DEFINE_BOOL(metal_texture_loads, true, "GPU/Metal", "Load textures from guest memory (diagnostic: false binds a blank texture)");
-REXCVAR_DEFINE_BOOL(metal_resolve_into_mips, true, "GPU/Metal",
-                    "A resolve that lands exactly on a level of a loaded texture with mips (same address, size, "
-                    "pitch and format) is copied into that level, and the texture kept. FIFA 19 builds a "
-                    "2048x2048 downsample chain level by level: each level dropped and reloaded the texture "
-                    "(8 MB untiled per level). false: every resolve drops what it overlaps");
+REXCVAR_DEFINE_BOOL(metal_resolve_into_textures, true, "GPU/Metal",
+                    "A resolve into the memory of a loaded tiled texture (a level of it at the resolve's address, the "
+                    "same pitch and format) is copied into that texture on the GPU, which is kept. Otherwise the "
+                    "resolve drops it and the next fetch untiles it from memory again: FIFA 19 resolves into the "
+                    "corner of a 2048x2048 texture (8 MB) and into targets whose fetched size is not a multiple of 8 "
+                    "every frame. false: every resolve drops what it overlaps");
+REXCVAR_DEFINE_BOOL(metal_resolve_into_textures_log, false, "GPU/Metal",
+                    "Diagnostic: log (once per address) each resolve that no loaded texture took, and why");
 REXCVAR_DEFINE_BOOL(metal_texture_mips, true, "GPU/Metal",
                     "Load textures' mip levels and sample them with the fetch's mip filter and anisotropic "
                     "filtering (anisotropic_override); false: the base level only, as before (shimmering "
@@ -417,9 +420,9 @@ void MetalDraw::EndFrame() {
         "{} vertex or index ranges ({} bytes) changed between two draws of a frame in 150 frames", thread_ms,
         wait_us_ / 1000.0 / 150, snapshot_changed_, snapshot_changed_bytes_);
     snapshot_changed_ = 0; snapshot_changed_bytes_ = 0;
-    if (resolves_into_mips_) {
-      REXGPU_INFO("Metal: {:.1f} resolves a frame copied into a loaded texture's mip level", resolves_into_mips_ / 150.0);
-      resolves_into_mips_ = 0;
+    if (resolves_into_textures_) {
+      REXGPU_INFO("Metal: {:.1f} resolves a frame copied into loaded textures", resolves_into_textures_ / 150.0);
+      resolves_into_textures_ = 0;
     }
     REXGPU_INFO("Metal frame time: {:.1f} ms a frame, GPU busy {:.1f} ms, CPU waiting for the GPU {:.1f} ms; {:.1f} texture loads ({:.1f} made from resolves, {:.0f} rows loaded for them), {:.1f} resolve textures reused, "
         "{:.1f} MB of vertices and indices hashed and {:.1f} MB copied ({:.0f} kept from earlier frames), {:.1f} MB of textures hashed ({:.1f} skipped by watches), "
@@ -462,7 +465,7 @@ void MetalDraw::EndFrame() {
       entry.texture = nil; entry.cached = false; entry.has_hash = false; entry.hash = 0; entry.checked_frame = 0;
       entry.has_range = false;
     }
-    cached_textures_ = 0; range_index_.clear(); max_range_length_ = 0; views_.clear(); mip_targets_.clear();
+    cached_textures_ = 0; range_index_.clear(); max_range_length_ = 0; views_.clear(); resolve_targets_.clear();
   }
 }
