   struct ResolvedTexture { id<MTLTexture> texture; uint32_t start, length, width, height, format, pitch = 0; };
   static bool ResolveFormatMatches(uint32_t resolved, uint32_t fetched);
-  // A level of a loaded tiled texture with mips that a resolve may land on exactly (metal_resolve_into_mips),
-  // by the level's guest address. The texture is checked against its entry's when used: a dropped or reloaded
-  // entry makes it stale.
-  struct MipTarget {
+  // A level of a loaded tiled texture that resolves may write into (metal_resolve_into_textures), by the level's
+  // guest address; several textures (other fetch constants) can share one. Checked against its entry when used:
+  // a dropped or reloaded entry makes it stale.
+  struct ResolveTarget {
     TextureEntry* entry;
     id<MTLTexture> texture;
     uint32_t level, width, height, pitch, format, length;
   };
-  std::unordered_map<uint32_t, MipTarget> mip_targets_;
-  uint64_t resolves_into_mips_ = 0;
-  void AddMipTarget(TextureEntry& entry, id<MTLTexture> texture, uint32_t level, uint32_t address, uint32_t width,
-                    uint32_t height, uint32_t pitch, uint32_t format, uint32_t length);
-  // Copies a resolve into the level of a loaded texture it lands on exactly, keeping that texture; false when
-  // there is none (the resolve then drops what it overlaps, as always).
-  bool ResolveIntoMip(id<MTLTexture> destination, uint32_t address, uint32_t width, uint32_t height, uint32_t pitch,
-                      uint32_t format, uint32_t extent_start, uint32_t extent_length);
+  std::unordered_multimap<uint32_t, ResolveTarget> resolve_targets_;
+  uint64_t resolves_into_textures_ = 0;
+  std::unordered_set<uint32_t> resolve_misses_logged_;
+  void AddResolveTarget(TextureEntry& entry, id<MTLTexture> texture, uint32_t level, uint32_t address, uint32_t width,
+                        uint32_t height, uint32_t pitch, uint32_t format, uint32_t length);
+  // Copies a resolve (its texture `destination`, written at dx, dy of the surface at `address`) into every loaded
+  // texture level at that address with the same tiled layout and format, keeping those textures, and drops what
+  // else it overlaps. False when no texture took it (the caller then drops everything it overlaps, as before).
+  bool ResolveIntoTextures(id<MTLTexture> destination, uint32_t address, uint32_t dx, uint32_t dy, uint32_t width,
+                           uint32_t height, uint32_t pitch, uint32_t format, uint32_t extent_start,
+                           uint32_t extent_length);
   static bool TilesDisjoint(uint32_t a_address, uint32_t a_width, uint32_t a_height, uint32_t a_pitch, uint32_t a_format,
                             uint32_t b_address, uint32_t b_width, uint32_t b_height, uint32_t b_pitch, uint32_t b_format);
   id<MTLTexture> ComposeResolves(uint32_t address, uint32_t width, uint32_t height, uint32_t pitch, uint32_t macro_row_bytes,
