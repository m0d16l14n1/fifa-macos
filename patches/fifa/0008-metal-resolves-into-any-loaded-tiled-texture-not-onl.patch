             for (uint32_t level = 1; level <= load_mip_levels && level < mip_layout.packed_level; ++level) {
               const auto& lv = mip_layout.mips[level];
-              AddMipTarget(entry, texture, level, mip_address + mip_layout.mip_offsets_bytes[level],
-                           std::max(w >> level, 1u), std::max(h >> level, 1u), lv.row_pitch_bytes / bpb,
-                           uint32_t(format), lv.level_data_extent_bytes);
+              AddResolveTarget(entry, texture, level, mip_address + mip_layout.mip_offsets_bytes[level],
+                               std::max(w >> level, 1u), std::max(h >> level, 1u), lv.row_pitch_bytes / bpb,
+                               uint32_t(format), lv.level_data_extent_bytes);
             }
           }
         }
@@ -2227,9 +2262,9 @@ bool MetalDraw::Resolve() {
               beside.emplace_back(a, r);
           for (auto& [a, r] : beside) resolved_.erase(a);
         }
-        if (constants.dx || constants.dy ||
-            !ResolveIntoMip(destination, address, width, height, resolved_pitch, resolved_format,
