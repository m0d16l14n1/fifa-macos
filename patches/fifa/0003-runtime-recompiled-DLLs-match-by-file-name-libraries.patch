From 73169c4d8fd239b932b1101e9adedc3e6f978791 Mon Sep 17 00:00:00 2001
From: Nick <nekreshen@yandex.ru>
Date: Sat, 7 Nov 2026 15:01:48 +0700
Subject: [PATCH 3/9] runtime: recompiled DLLs match by file name; libraries
 load from the executable's folder

FIFA 19 loads powdllzf and FootballCompEngzf from dlc paths that differ from
the manifest's. The shared library is <exe folder>/lib<name>.dylib on macOS
(.so on Linux, .dll on Windows) instead of a bare name dlopen would not find.
---
 include/rex/system/kernel_state.h |  3 ++
 src/system/kernel_state.cpp       | 47 ++++++++++++++++++++++++++++---
 2 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/include/rex/system/kernel_state.h b/include/rex/system/kernel_state.h
index 9b9cf9e..4ffebf4 100644
--- a/include/rex/system/kernel_state.h
+++ b/include/rex/system/kernel_state.h
@@ -257,6 +257,9 @@ class KernelState {
   void RegisterRecompiledModule(const char* pe_name, const char* guest_path,
                                 const char* shared_lib_name);
   std::optional<RecompiledModuleInfo> FindRecompiledModule(std::string_view guest_path);
+  // Where a recompiled module's shared library is: the executable's folder, with the
+  // platform's prefix and suffix (lib<name>.dylib on macOS).
+  static std::filesystem::path RecompiledModuleLibraryPath(std::string_view shared_lib_name);
 
   object_ref<KernelModule> GetKernelModule(const std::string_view name);
   template <typename T>
diff --git a/src/system/kernel_state.cpp b/src/system/kernel_state.cpp
index 697399c..08afe76 100644
--- a/src/system/kernel_state.cpp
+++ b/src/system/kernel_state.cpp
@@ -16,6 +16,7 @@
 
 #include <fmt/format.h>
 #include <rex/assert.h>
+#include <rex/filesystem.h>
 #include <rex/image_info.h>
 #include <rex/logging.h>
 #include <rex/math.h>
@@ -759,9 +760,10 @@ object_ref<UserModule> KernelState::LoadUserModule(const std::string_view raw_na
     }
 
     rex::platform::DynamicLibrary library_local;
-    if (!library_local.Load(std::filesystem::path(recomp->shared_lib_name),
-                            rex::platform::SymbolResolution::kImmediate)) {
-      REXSYS_ERROR("Failed to load shared library for module '{}'", recomp->pe_name);
+    const auto library_path = RecompiledModuleLibraryPath(recomp->shared_lib_name);
+    if (!library_local.Load(library_path, rex::platform::SymbolResolution::kImmediate)) {
+      REXSYS_ERROR("Failed to load shared library '{}' for module '{}'",
+                   rex::path_to_utf8(library_path), recomp->pe_name);
     } else {
       auto register_func = reinterpret_cast<runtime::FunctionDispatcher::RegisterFn>(
           library_local.GetRawSymbol("ReXModule_Register"));
@@ -787,7 +789,7 @@ object_ref<UserModule> KernelState::LoadUserModule(const std::string_view raw_na
               xex->base_address() + xex->image_size());
         } else if (!function_dispatcher_->InitializeFunctionTable(
                        image_info->code_base, image_info->code_size, image_info->image_base,
-                       image_info->image_size)) {
+                       image_info->image_size, /*is_entrypoint=*/false, image_info->table_base)) {
           REXSYS_ERROR("InitializeFunctionTable failed for module '{}'", recomp->pe_name);
         } else {
           function_dispatcher_->RegisterModule(lib_key, image_info->code_base, register_func);
@@ -919,9 +921,46 @@ std::optional<KernelState::RecompiledModuleInfo> KernelState::FindRecompiledModu
     if (info.guest_path == normalized)
       return info;
   }
+  // A game can load a DLL by another path than the one codegen recorded (FIFA 19 loads
+  // "game:\dlc\dlc_powdll\dlc\powdll\powdllzf.xex.dll"; the manifest names it
+  // "game:\powdllzf.xex.dll"). Fall back to the file name when exactly one module has it.
+  auto file_name = [](std::string_view path) {
+    const auto slash = path.find_last_of("\\/");
+    return slash == std::string_view::npos ? path : path.substr(slash + 1);
+  };
+  const auto wanted = file_name(normalized);
+  const RecompiledModuleInfo* match = nullptr;
+  for (const auto& info : recompiled_modules_) {
+    if (rex::string::utf8_equal_case(file_name(info.guest_path), wanted)) {
+      if (match) {
+        REXSYS_ERROR("FindRecompiledModule: '{}' matches more than one module by file name",
+                     normalized);
+        return std::nullopt;
+      }
+      match = &info;
+    }
+  }
+  if (match) {
+    REXSYS_INFO("FindRecompiledModule: '{}' is '{}' (matched by file name)", normalized,
+                match->guest_path);
+    return *match;
+  }
   return std::nullopt;
 }
 
+std::filesystem::path KernelState::RecompiledModuleLibraryPath(std::string_view shared_lib_name) {
+  // Module libraries are built next to the executable (and copied into an app bundle beside it),
+  // with the platform's library prefix and suffix; dlopen would not look there by a bare name.
+#if REX_PLATFORM_WIN32
+  const std::string file = fmt::format("{}.dll", shared_lib_name);
+#elif REX_PLATFORM_MAC
+  const std::string file = fmt::format("lib{}.dylib", shared_lib_name);
+#else
+  const std::string file = fmt::format("lib{}.so", shared_lib_name);
+#endif
+  return rex::filesystem::GetExecutableFolder() / file;
+}
+
 void KernelState::SignalAllWaitableObjects() {
   auto global_lock = global_critical_region_.Acquire();
   auto objects = object_table_.GetAllObjects();
