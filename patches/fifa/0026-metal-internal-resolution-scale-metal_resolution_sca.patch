   // A resolve's own texture, used in place of a load from guest memory only by a fetch of exactly
   // what it wrote (same address, size and format). Guest memory is the truth for everything else.
-  struct ResolvedTexture { id<MTLTexture> texture; uint32_t start, length, width, height, format, pitch = 0; };
+  // texture: what later draws sample (at the resolution scale's size); unscaled: the guest-size copy (the same
+  // texture without a scale), for composing and copying into loaded textures.
+  struct ResolvedTexture {
+    id<MTLTexture> texture; uint32_t start, length, width, height, format, pitch = 0;
+    id<MTLTexture> unscaled = nil;
+    id<MTLTexture> guest() const { return unscaled ? unscaled : texture; }
+  };
+  // Resolve outputs made at the scaled size carry this label (kept through the texture pool, unlike a pointer
+  // set): a draw that samples one flags its fetch constant (textures_resolution_scaled) so unnormalized
+  // coordinates and offsets are scaled.
+  uint32_t textures_scaled_mask_ = 0;
+  static bool IsScaledTexture(id<MTLTexture> t) {
+    while (t.parentTexture) t = t.parentTexture;
+    return [t.label isEqualToString:@"Xenos resolve, scaled"];
+  }
   static bool ResolveFormatMatches(uint32_t resolved, uint32_t fetched);
   // A level of a loaded tiled texture that resolves may write into (metal_resolve_into_textures), by the level's
   // guest address; several textures (other fetch constants) can share one. Checked against its entry when used:
