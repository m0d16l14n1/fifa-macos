From 6a8a1c0077e1b0f3a817df8cc00a3f56333a29ac Mon Sep 17 00:00:00 2001
From: Nick <nekreshen@yandex.ru>
Date: Sun, 8 Nov 2026 13:54:04 +0700
Subject: [PATCH] metal: internal resolution scale (metal_resolution_scale)

Render targets are made N times the guest's size across and down; draws get the scaled viewport and scissor;
clears, EDRAM transfers and resolves read and write the scaled textures while all EDRAM bookkeeping stays in
guest units. A resolve writes guest memory and a guest-size texture (each pixel the middle texel of its block)
and, in a second pass, the full-size texture later draws sample (labelled, so their fetch constants get
textures_resolution_scaled); shaders are translated with the scale (pixel positions divided by it). The guest
output, temporal AA (HdrDrawResolutionScale) and the front buffer copy follow the scaled size.
---
 src/graphics/metal/metal_command_processor.mm |   8 +-
 src/graphics/metal/metal_draw.h               |  24 +++-
 src/graphics/metal/metal_draw.mm              | 128 ++++++++++++------
 src/graphics/metal/metal_internal.h           |   2 +
 src/graphics/metal/metal_resolve.h            |  69 ++++++----
 .../metal/metal_shader_translator.cpp         |  17 ++-
 src/graphics/metal/metal_shader_translator.h  |   2 +-
 src/graphics/temporal_aa.cpp                  |   7 +-
 8 files changed, 182 insertions(+), 75 deletions(-)

diff --git a/src/graphics/metal/metal_command_processor.mm b/src/graphics/metal/metal_command_processor.mm
index 05c00e5..c465f2c 100644
--- a/src/graphics/metal/metal_command_processor.mm
+++ b/src/graphics/metal/metal_command_processor.mm
@@ -560,6 +560,10 @@ void MetalCommandProcessor::WriteFenceValue(uint32_t address, uint32_t value) {
   CommandProcessor::WriteFenceValue(address, value);
 }
 
+void MetalCommandProcessor::HdrDrawResolutionScale(uint32_t& x, uint32_t& y) const {
+  x = y = draw_ ? draw_->resolution_scale() : 1;
+}
+
 void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
                                       uint32_t frontbuffer_width, uint32_t frontbuffer_height) {
   if (draw_) draw_->EndFrame();
@@ -599,8 +603,10 @@ void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
     static_assert(sizeof(reg::DC_LUT_30_COLOR) == 4 && sizeof(reg::DC_LUT_PWL_DATA) == 4);
     std::memcpy(gamma->table, gamma_ramp_256_entry_table(), sizeof(gamma->table));
     std::memcpy(gamma->pwl, gamma_ramp_pwl_rgb(), sizeof(gamma->pwl));
+    // The front buffer is a resolve at the resolution scale's size (metal_resolution_scale): so is the output.
+    const uint32_t scale = draw_ ? draw_->resolution_scale() : 1;
     presenter->RefreshGuestOutput(
-        frontbuffer_width, frontbuffer_height, 1280, 720,
+        frontbuffer_width * scale, frontbuffer_height * scale, 1280, 720,
         [this, frontbuffer_ptr, swap, gamma](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
           auto& metal_context = static_cast<MetalGuestOutputRefreshContext&>(context);
           @autoreleasepool {
