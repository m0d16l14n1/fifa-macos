+  // metal_resolution_scale: a render target texel per guest texel across and down. The EDRAM bookkeeping (rows,
+  // tiles, pass sizes, clears) stays in guest units; only what Metal is given (texture sizes, viewports,
+  // scissors, render areas, resolve and transfer reads) is scaled. GuestWidth/GuestHeight undo it for a target.
+  uint32_t scale_ = 1;
+  uint32_t GuestWidth(id<MTLTexture> t) const { return uint32_t(t.width) / scale_; }
+  uint32_t GuestHeight(id<MTLTexture> t) const { return uint32_t(t.height) / scale_; }
